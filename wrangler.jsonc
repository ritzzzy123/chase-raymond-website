{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chase-raymond-website",
  "main": "worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
